{
  "project": {
    "name": "romance_rhythm_mvp",
    "path": "C:\\AI\\projects\\P0007_MadeInMaghribalt3",
    "summary": "ブラウザで遊べる、中東ファンタジー恋愛VN＋接客リズムクイズゲーム。舞台はマグリバル王国。主人公ナーディルは若い錬金術師で、錬金術店を営む。ゲームはADV/VNを本体とし、BGMに合わせて客へ商品を売る横スクロール型音ゲー＋2択クイズの営業ミニゲームを挟む。ヒロインは3人。ゲーム開始時に1人を選び、5ターン制の本編を一周し、営業成績から算出される好感度で2種類のエンディングへ分岐する。Good Ending後には追加ルートとFree Playを解放する。デバッグ用URLパラメータによる特定フェーズへのジャンプ機能を備え、ブラウザSmokeテスト(Playwright)による品質検証をサポートする。",
    "target_platform": "browser",
    "language": "ja",
    "repository_policy": {
      "root_repository": "development",
      "public_repository": "github_pages",
      "public_is_nested_git_repository": true
    },
    "runtime_constraints": [
      "HTML/CSS/JavaScript",
      "no external runtime server",
      "no required external runtime libraries",
      "GitHub Pages compatible",
      "mobile touch first",
      "no hover-only UI",
      "no keyboard-only UI",
      "HD portrait fixed logical resolution 720x1280",
      "scale-to-fit without page scroll"
    ],
    "mcp_stack": {
      "use": [
        "KawazuContractHub",
        "KawazuDevHelper",
        "filesystem"
      ],
      "do_not_use": [
        "Serena",
        "OpenRouter",
        "old handoff/export/snapshot flow",
        "old agent_build",
        "model dispatch from ContractHub"
      ]
    },
    "design_principles": [
      "data single responsibility",
      "no scenario text embedded in renderer",
      "no heroine tone rules duplicated across scenario files",
      "no item id or audio path hardcoded into UI implementation",
      "UI/UX changes must not require scenario data edits",
      "scenario changes must not require renderer edits",
      "MVP data may be small but schema must support mass content insertion later"
    ],
    "mvp_scope": [
      "title",
      "opening",
      "heroine select",
      "5-turn main game",
      "before-open VN talk",
      "rhythm quiz sales phase",
      "turn result",
      "after-close VN talk",
      "ending branch",
      "unlock flag model",
      "sample data and validators"
    ],
    "non_goals": [
      "mass scenario implementation",
      "mass daily talk generation",
      "advanced music analysis",
      "multi-lane rhythm game",
      "high-density notes",
      "complex quiz conditions",
      "advanced gallery system",
      "multiple save slots",
      "asset generation or processing pipeline",
      "server-side processing",
      "npm audio analysis libraries"
    ]
  },
