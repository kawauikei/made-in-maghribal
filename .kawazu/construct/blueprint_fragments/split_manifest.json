{
  "fragment_type": "split_manifest",
  "project_name": "romance_rhythm_mvp",
  "version": 1,
  "description": "MadeInMaghribal fantasy romance rhythm VN MVP blueprint fragments.",
  "fragments": [
    "00_project.json",
    "10_data_schema_contracts.json",
    "20_content_data_contracts.json",
    "30_quiz_rhythm_score_contracts.json",
    "40_session_render_contracts.json",
    "90_non_contract_integration.json"
  ],
  "merge_policy": {
    "required_contracts_form_initial_mvp_closure": true,
    "required_must_not_depend_on_optional_or_deferred": true,
    "browser_public_css_bundle_in_non_contract": true,
    "no_duplicate_contract_id": true,
    "no_duplicate_paths": true
  },
  "stop_after": [
    "project_initialize",
    "blueprint_merge",
    "blueprint_lint",
    "build_queue"
  ],
  "do_not_create_yet": [
    "contract_bundle",
    "spec",
    "testspec",
    "source",
    "test",
    "public_integration",
    "ui_implementation",
    "scenario_mass_generation"
  ]
}
